{
    "name": "aryeo/api-resource-schema",
    "description": "A typed layer over Laravel API Resources that describes the JSON contract with PHP accessor properties.",
    "license": "MIT",
    "type": "library",
    "repositories": {
        "artifactory": {
            "type": "composer",
            "url": "https://artifactory.zgtools.net/artifactory/api/composer/listing-and-vendor-management-composer/",
            "only": [
                "aryeo/*",
                "zillow/*"
            ]
        }
    },
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12.37 || ^13",
        "symfony/console": "^7.0 || ^8.0",
        "phpstan/phpstan": "^2.1",
        "nikic/php-parser": "^5.7",
        "aryeo/tooling-laravel": "0.0.43",
        "laravel/prompts": "^0.3.17",
        "aryeo/eloquent-concurrency": "0.0.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6 || ^11",
        "brianium/paratest": "^7.14",
        "phpunit/phpunit": "^12.4.1 || ^13",
        "pestphp/pest": "^4.1",
        "orchestra/testbench-core": "^10.7 || ^11",
        "nesbot/carbon": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support",
            "Tooling\\": "src/Tooling/"
        },
        "exclude-from-classmap": [
            "**/*Test.php",
            "**/*TestCases.php",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Http\\Resources\\Schemas\\Providers\\Provider"
            ]
        },
        "tooling": {
            "rector": {
                "configured_rules": "tooling/rector/configured-rules.php",
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                }
            },
            "phpstan": {
                "rules": "tooling/phpstan/phpstan.neon",
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                }
            },
            "pint": {
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                }
            }
        }
    }
}
