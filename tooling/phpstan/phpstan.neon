includes:
    - schema-collection-return-type.neon

services:
    -
        class: PhpParser\ParserFactory

    -
        class: PhpParser\Parser
        factory: @PhpParser\ParserFactory::createForNewestSupportedVersion()
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemaVersionResolver
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemaMustUseAsSchema
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\AsSchemaCanOnlyBeAddedToSchema
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemaCollectionMustUseAsSchemaCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\AsSchemaCollectionCanOnlyBeAddedToSchemaCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemaCollectionMustDefineCollects
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemaMustDefineCollectedBy
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemaMustDefineVersion
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemaMustNotDefineWithResponse
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemableMustUseTransformsToSchema
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\TransformsToSchemaCanOnlyBeAddedToSchemable
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemableCollectionMustUseTransformsToSchemaCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\TransformsToSchemaCollectionCanOnlyBeAddedToSchemableCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemableMustDefineCollectedBy
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemableCollectedByMustNotBeBaseCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemableCollectedByMustImplementSchemableCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\UseSchemaMustHaveMatchingUseSchemaCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\UseSchemaCollectionMustHaveMatchingUseSchema
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\VersionableMustUseTransformsToVersion
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\TransformsToVersionCanOnlyBeAddedToVersionable
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\VersionedEnumMustUseAsVersionedEnum
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\AsVersionedEnumCanOnlyBeAddedToVersionedEnum
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\VersionableMustDefineRepresentedBy
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\RepresentedByCanOnlyBeAddedToVersionable
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\RepresentedByTargetMustBeVersioned
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\VersionedMustDefineVersion
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\UseSchemaTargetMustBeSchema
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\UseSchemaCollectionTargetMustBeSchemaCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\CollectsTargetMustBeSchema
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\CollectedByTargetMustBeSchemaCollection
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\RepresentedByMustNotDuplicateVersion
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\UseSchemaMustNotDuplicateVersion
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\UseSchemaCollectionMustNotDuplicateVersion
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\RepresentsCanOnlyBeAddedToAsVersionedEnum
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\EnumImplementingVersionedMustImplementVersionedEnum
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\VersionedEnumMustNotDefineRepresenting
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\VersionableEnumMustBeFullyRepresented
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\VersionableFieldMustSupportSchemaVersion
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemableFieldMustSupportSchemaVersion
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\ApiResourceSchema\PhpStan\Rules\SchemableCollectionFieldMustSupportSchemaVersion
        tags:
            - phpstan.rules.rule
